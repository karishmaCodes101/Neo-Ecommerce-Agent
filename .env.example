# Which LLM backend to use: "openai" or "ollama"
LLM_PROVIDER=ollama

# --- OpenAI settings (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama settings (used when LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=smollm:135m
OLLAMA_BASE_URL=http://localhost:11434

# --- Real Flipkart data (optional) ---
FLIPKART_DATA_SOURCE=duckduckgo
SERPAPI_KEY=

LOG_LEVEL=INFO